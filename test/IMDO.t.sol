    // ----- fee schedule -----

    /// forge-config: default.fuzz.runs = 2000
    function testFuzz_feeRateFollowsTheBracketTable(uint256 sold, uint256 reserve) public view {
        sold = bound(sold, 0, 1e40);
        reserve = bound(reserve, 0, 1e40);
        uint24 rate = hook.feeRate(sold, reserve);
        le(uint256(rate), 20_000, "cap");
        if (sold == 0) {
            eq(uint256(rate), 0, "nothing sold");
            return;
        }
        if (reserve == 0) {
            eq(uint256(rate), 20_000, "zero reserve is billed at the cap");
            return;
        }
        uint256 bps = sold * 10_000 / reserve;
        uint24 expected = bps < 100 ? 0 : bps < 300 ? 5_000 : bps < 500 ? 10_000 : 20_000;
        eq(uint256(rate), uint256(expected), "bracket");
    }

    function test_buysAreFreeInBothModes() public {
        uint256 treasuryBefore = TREASURY.balance;
