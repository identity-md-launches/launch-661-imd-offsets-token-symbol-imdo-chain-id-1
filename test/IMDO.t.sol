/*
 * IMDO test suite.
 *
 * The repository ships no forge-std and no v4-core (the implementation is dependency free and
 * this task may only write this file), so everything the suite needs is declared here:
 *   - a minimal cheatcode interface,
 *   - the Uniswap v4 PoolManager (v4-core 0.8.26, via-ir, cancun) as creation bytecode, deployed
 *     for real in each fixture so swaps, liquidity, LP fee growth and settlement are the genuine
 *     v4 accounting rather than a mock,
 *   - a factory-style launcher, a swap router, a payout splitter and a Merkle distributor stub.
 *
 * Foundry here isolates every top-level call from a test as its own transaction (transient
 * storage is cleared between them, block.number is not advanced). "Same transaction" scenarios
 * are therefore driven through a single Router.execute call that performs several pool actions
 * inside one unlock, and "different transactions" are simply separate top-level calls.
 */

interface Vm {
    struct Log {
        bytes32[] topics;
        bytes data;
        address emitter;
    }

    function prank(address) external;
    function prank(address, address) external;
    function startPrank(address) external;
    function stopPrank() external;
    function deal(address, uint256) external;
    function roll(uint256) external;
    function etch(address, bytes calldata) external;
    function expectRevert() external;
    function expectRevert(bytes4) external;
    function expectRevert(bytes calldata) external;
    function assume(bool) external pure;
    function chainId(uint256) external;
    function recordLogs() external;
    function getRecordedLogs() external returns (Log[] memory);
    function label(address, string calldata) external;
    function envOr(string calldata, uint256) external view returns (uint256);
    function envOr(string calldata, address) external view returns (address);
}

/// @dev The v4 PoolManager surface the suite drives, with the hook's ABI-equivalent tuples.
interface IV4 {
    function unlock(bytes calldata data) external returns (bytes memory);
    function initialize(IMDPoolKey memory key, uint160 sqrtPriceX96) external returns (int24);
    function modifyLiquidity(IMDPoolKey memory key, IMDModifyLiquidityParams memory params, bytes calldata hookData)
        external
        returns (int256 callerDelta, int256 feesAccrued);
    function swap(IMDPoolKey memory key, IMDSwapParams memory params, bytes calldata hookData) external returns (int256);
    function donate(IMDPoolKey memory key, uint256 amount0, uint256 amount1, bytes calldata hookData)
        external
        returns (int256);
    function sync(address currency) external;
    function take(address currency, address to, uint256 amount) external;
    function settle() external payable returns (uint256);
    function mint(address to, uint256 id, uint256 amount) external;
    function burn(address from, uint256 id, uint256 amount) external;
    function balanceOf(address owner, uint256 id) external view returns (uint256);
    function extsload(bytes32 slot) external view returns (bytes32);
    function exttload(bytes32 slot) external view returns (bytes32);
    function protocolFeesAccrued(address currency) external view returns (uint256);
    function setProtocolFeeController(address controller) external;
    function setProtocolFee(IMDPoolKey memory key, uint24 newProtocolFee) external;
    function collectProtocolFees(address recipient, address currency, uint256 amount) external returns (uint256);
    function owner() external view returns (address);
}

library V4 {
    uint160 internal constant SQRT_1_1 = 79228162514264337593543950336;
    uint160 internal constant MIN_SQRT = 4295128739;
    uint160 internal constant MAX_SQRT = 1461446703485210103287273052203988822378723970342;
    int24 internal constant TICK_LOWER = -887220;
    int24 internal constant TICK_UPPER = 887220;
    uint256 internal constant POOLS_SLOT = 6;

    function poolId(IMDPoolKey memory key) internal pure returns (bytes32) {
        return keccak256(abi.encode(key));
    }

    function stateSlot(IMDPoolKey memory key) internal pure returns (bytes32) {
        return keccak256(abi.encodePacked(poolId(key), bytes32(POOLS_SLOT)));
    }

    function liquidity(IV4 m, IMDPoolKey memory key) internal view returns (uint128) {
        return uint128(uint256(m.extsload(bytes32(uint256(stateSlot(key)) + 3))));
    }

    function slot0(IV4 m, IMDPoolKey memory key)
        internal
        view
        returns (uint160 sqrtPriceX96, int24 tick, uint24 protocolFee, uint24 lpFee)
    {
        uint256 data = uint256(m.extsload(stateSlot(key)));
        sqrtPriceX96 = uint160(data);
        tick = int24(int256(data >> 160));
        protocolFee = uint24(data >> 184);
        lpFee = uint24(data >> 208);
    }

    function feeGrowthGlobals(IV4 m, IMDPoolKey memory key) internal view returns (uint256 g0, uint256 g1) {
        bytes32 s = stateSlot(key);
        g0 = uint256(m.extsload(bytes32(uint256(s) + 1)));
        g1 = uint256(m.extsload(bytes32(uint256(s) + 2)));
    }

    function positionLiquidity(IV4 m, IMDPoolKey memory key, address owner, int24 tl, int24 tu, bytes32 salt)
        internal
        view
        returns (uint128)
    {
        bytes32 positionId = keccak256(abi.encodePacked(owner, tl, tu, salt));
        bytes32 slot = keccak256(abi.encodePacked(positionId, bytes32(uint256(stateSlot(key)) + 6)));
        return uint128(uint256(m.extsload(slot)));
    }

    function delta(IV4 m, address target, address currency) internal view returns (int256) {
        return int256(uint256(m.exttload(keccak256(abi.encode(target, currency)))));
    }

    function amount0(int256 d) internal pure returns (int256) {
        return int256(int128(d >> 128));
    }

    function amount1(int256 d) internal pure returns (int256) {
        return int256(int128(d));
    }

    function mineSalt(address deployer, bytes32 initCodeHash, uint160 flags)
        internal
        pure
        returns (bytes32 salt, address predicted)
    {
        for (uint256 i; i < 400_000; ++i) {
            salt = bytes32(i);
            predicted =
                address(uint160(uint256(keccak256(abi.encodePacked(bytes1(0xff), deployer, salt, initCodeHash)))));
            if (uint160(predicted) & 0x3fff == flags) return (salt, predicted);
        }
        revert("no salt");
    }
}

/// @dev Uniswap v4-core PoolManager creation code (solc 0.8.26, via-ir, cancun, no metadata).
contract V4Code {
    function creationCode() external pure returns (bytes memory) {
        return hex"";
    }
}

struct Action {
    uint8 kind; // 0 swap(a = zeroForOne, b = amountSpecified), 1 modify(a = tl, b = tu, c = liquidityDelta), 2 donate(a, b)
    int256 a;
    int256 b;
    int256 c;
}

/// @dev Generic swap/liquidity router: every action list is one unlock, so one transaction.
contract Router {
    IV4 public immutable manager;
    IMDOToken public immutable token;
    address public payer;

    constructor(IV4 manager_, IMDOToken token_) {
        manager = manager_;
        token = token_;
    }

    receive() external payable {}

    function execute(IMDPoolKey calldata key, Action[] calldata actions)
        external
        payable
        returns (int256[] memory deltas)
    {
        payer = msg.sender;
        deltas = abi.decode(manager.unlock(abi.encode(key, actions)), (int256[]));
        uint256 left = address(this).balance;
        if (left != 0) {
            (bool ok,) = msg.sender.call{value: left}("");
            require(ok, "refund");
        }
    }

    function unlockCallback(bytes calldata data) external returns (bytes memory) {
        require(msg.sender == address(manager), "router: manager");
        (IMDPoolKey memory key, Action[] memory actions) = abi.decode(data, (IMDPoolKey, Action[]));
        int256[] memory deltas = new int256[](actions.length);
        for (uint256 i; i < actions.length; ++i) {
            Action memory act = actions[i];
            if (act.kind == 0) {
                bool zeroForOne = act.a != 0;
                deltas[i] = manager.swap(
                    key, IMDSwapParams(zeroForOne, act.b, zeroForOne ? V4.MIN_SQRT + 1 : V4.MAX_SQRT - 1), ""
                );
            } else if (act.kind == 1) {
                (deltas[i],) =
                    manager.modifyLiquidity(key, IMDModifyLiquidityParams(int24(act.a), int24(act.b), act.c, 0), "");
            } else {
                deltas[i] = manager.donate(key, uint256(act.a), uint256(act.b), "");
            }
        }
        _settle(address(token));
        _settle(address(0));
        return abi.encode(deltas);
    }

    function _settle(address currency) internal {
        int256 d = V4.delta(manager, address(this), currency);
        if (d < 0) {
            uint256 amount = uint256(-d);
            if (currency == address(0)) {
                manager.settle{value: amount}();
            } else {
                manager.sync(currency);
                token.transferFrom(payer, address(manager), amount);
                manager.settle();
            }
        } else if (d > 0) {
            manager.take(currency, payer, uint256(d));
        }
    }
}

/// @dev Stand-in for the swarm's Merkle distributor: plain token transfers against a fixed root.
contract MerkleDistributor {
    IMDOToken public immutable token;
    bytes32 public immutable root;
    mapping(uint256 => bool) public claimed;

    constructor(IMDOToken token_, bytes32 root_) {
        token = token_;
        root = root_;
    }

    function claim(uint256 index, address account, uint256 amount, bytes32[] calldata proof) external {
        require(!claimed[index], "claimed");
        bytes32 node = keccak256(abi.encodePacked(index, account, amount));
        for (uint256 i; i < proof.length; ++i) {
            bytes32 p = proof[i];
            node = node < p ? keccak256(abi.encodePacked(node, p)) : keccak256(abi.encodePacked(p, node));
        }
        require(node == root, "proof");
        claimed[index] = true;
        require(token.transfer(account, amount), "transfer");
    }
}

/// @dev Factory-style launcher: creates the token, CREATE2-deploys the hook at a mined address,
/// initialises the hooked pool (and an identical hookless mirror pool when asked), seeds the
/// launch position in the same transaction, funds the swarm distributor and hands the rest of
/// the supply to a public holder. It also owns the position, collects its LP fees and pays them
/// to its own fixed payees, standing in for "whoever the factory pays today".
contract LaunchFactory {
    IV4 public immutable manager;
    IMDOToken public token;
    IMDOFeeHook public hook;
    MerkleDistributor public distributor;
    bytes32 public hookSalt;
    IMDPoolKey public key;
    IMDPoolKey public mirror;
    bool public hasMirror;
    address public payeeA;
    address public payeeB;
    int24 public tickLower;
    int24 public tickUpper;

    constructor(IV4 manager_, address payeeA_, address payeeB_) {
        manager = manager_;
        payeeA = payeeA_;
        payeeB = payeeB_;
    }

    receive() external payable {}

    function hookedKey() external view returns (IMDPoolKey memory) {
        return key;
    }

    function mirrorKey() external view returns (IMDPoolKey memory) {
        return mirror;
    }

    struct LaunchParams {
        uint24 fee;
        int24 tickLower;
        int24 tickUpper;
        uint128 liquidity;
        bool withMirror;
        bytes32 merkleRoot;
        uint256 distributorAmount;
        address publicHolder;
    }

    function launch(LaunchParams calldata p) external payable {
        token = new IMDOToken();
        bytes32 initHash =
            keccak256(abi.encodePacked(type(IMDOFeeHook).creationCode, abi.encode(address(manager), address(token))));
        (bytes32 salt, address predicted) = V4.mineSalt(address(this), initHash, 0x25d4);
        hook = new IMDOFeeHook{salt: salt}(address(manager), address(token));
        require(address(hook) == predicted, "create2 mismatch");
        hookSalt = salt;
        key = IMDPoolKey(address(0), address(token), p.fee, 60, address(hook));
        manager.initialize(key, V4.SQRT_1_1);
        if (p.withMirror) {
            mirror = IMDPoolKey(address(0), address(token), p.fee, 60, address(0));
            manager.initialize(mirror, V4.SQRT_1_1);
            hasMirror = true;
        }
        tickLower = p.tickLower;
        tickUpper = p.tickUpper;
        manager.unlock(abi.encode(uint8(0), int256(uint256(p.liquidity))));
        if (p.distributorAmount != 0) {
            distributor = new MerkleDistributor(token, p.merkleRoot);
            token.transfer(address(distributor), p.distributorAmount);
        }
        token.transfer(p.publicHolder, token.balanceOf(address(this)));
    }

    /// @notice Collect LP fees from the launch position(s) (zero liquidity delta).
    function collect() external returns (int256 hookedFees, int256 mirrorFees) {
        bytes memory r = manager.unlock(abi.encode(uint8(1), int256(0)));
        (hookedFees, mirrorFees) = abi.decode(r, (int256, int256));
    }

    /// @notice Remove part of the launch position(s).
    function withdraw(uint128 liquidity) external returns (int256 hookedDelta, int256 mirrorDelta) {
        bytes memory r = manager.unlock(abi.encode(uint8(2), -int256(uint256(liquidity))));
        (hookedDelta, mirrorDelta) = abi.decode(r, (int256, int256));
    }

    /// @notice Pay everything the factory holds to its fixed payees, 60/40.
    function distribute() external {
        uint256 eth = address(this).balance;
        uint256 tok = token.balanceOf(address(this));
        uint256 ethA = eth * 60 / 100;
        uint256 tokA = tok * 60 / 100;
        (bool ok,) = payeeA.call{value: ethA}("");
        require(ok, "payeeA");
        (ok,) = payeeB.call{value: eth - ethA}("");
        require(ok, "payeeB");
        token.transfer(payeeA, tokA);
        token.transfer(payeeB, tok - tokA);
    }

    function unlockCallback(bytes calldata data) external returns (bytes memory) {
        require(msg.sender == address(manager), "factory: manager");
        (uint8 kind, int256 liquidityDelta) = abi.decode(data, (uint8, int256));
        int256 hooked;
        int256 mirrored;
        IMDModifyLiquidityParams memory params = IMDModifyLiquidityParams(tickLower, tickUpper, liquidityDelta, 0);
        if (kind == 1) {
            (, hooked) = manager.modifyLiquidity(key, params, "");
            if (hasMirror) (, mirrored) = manager.modifyLiquidity(mirror, params, "");
        } else {
            (hooked,) = manager.modifyLiquidity(key, params, "");
            if (hasMirror) (mirrored,) = manager.modifyLiquidity(mirror, params, "");
        }
        _settle(address(token));
        _settle(address(0));
        return abi.encode(hooked, mirrored);
    }

    function _settle(address currency) internal {
        int256 d = V4.delta(manager, address(this), currency);
        if (d < 0) {
            uint256 amount = uint256(-d);
            if (currency == address(0)) {
                manager.settle{value: amount}();
            } else {
                manager.sync(currency);
                token.transfer(address(manager), amount);
                manager.settle();
            }
        } else if (d > 0) {
            manager.take(currency, address(this), uint256(d));
        }
    }
}

/// @dev Minimal assertion helpers (no forge-std in this repository).
abstract contract Asserts {
    function _str(uint256 v) internal pure returns (string memory) {
        if (v == 0) return "0";
        bytes memory buf = new bytes(78);
        uint256 i = 78;
        while (v != 0) {
            buf[--i] = bytes1(uint8(48 + v % 10));
            v /= 10;
        }
        bytes memory out = new bytes(78 - i);
        for (uint256 j; j < out.length; ++j) {
            out[j] = buf[i + j];
        }
        return string(out);
    }

    function _str(int256 v) internal pure returns (string memory) {
        return v < 0 ? string.concat("-", _str(uint256(-v))) : _str(uint256(v));
    }

    function eq(uint256 a, uint256 b, string memory m) internal pure {
        if (a != b) revert(string.concat(m, ": ", _str(a), " != ", _str(b)));
    }

    function eq(int256 a, int256 b, string memory m) internal pure {
        if (a != b) revert(string.concat(m, ": ", _str(a), " != ", _str(b)));
    }

    function eq(address a, address b, string memory m) internal pure {
        if (a != b) revert(string.concat(m, ": address mismatch"));
    }

    function eq(bytes32 a, bytes32 b, string memory m) internal pure {
        if (a != b) revert(string.concat(m, ": bytes32 mismatch"));
    }

    function ok(bool c, string memory m) internal pure {
        if (!c) revert(m);
    }

    function le(uint256 a, uint256 b, string memory m) internal pure {
        if (a > b) revert(string.concat(m, ": ", _str(a), " > ", _str(b)));
    }

    function gt(uint256 a, uint256 b, string memory m) internal pure {
        if (a <= b) revert(string.concat(m, ": ", _str(a), " <= ", _str(b)));
    }

    /// @dev Scan runtime code for SELFDESTRUCT / DELEGATECALL / CALLCODE, skipping PUSH immediates
    /// and the trailing CBOR metadata (its length is the last two bytes), which the default build
    /// appends and the attested build (--no-metadata) does not.
    function assertNoEscapeOpcodes(bytes memory code, string memory what) internal pure {
        gt(code.length, 2, what);
        uint256 metaLen = (uint256(uint8(code[code.length - 2])) << 8) | uint256(uint8(code[code.length - 1]));
        uint256 end = metaLen + 2 <= code.length ? code.length - metaLen - 2 : code.length;
        for (uint256 i; i < end; ++i) {
            uint8 op = uint8(code[i]);
            if (op >= 0x60 && op <= 0x7f) {
                i += op - 0x5f;
                continue;
            }
            ok(op != 0xff && op != 0xf4 && op != 0xf2, string.concat(what, ": escape opcode in runtime"));
        }
    }

    function bound(uint256 x, uint256 lo, uint256 hi) internal pure returns (uint256) {
        if (hi < lo) hi = lo;
        if (x >= lo && x <= hi) return x;
        uint256 size = hi - lo + 1;
        if (size == 0) return x;
        return lo + (x % size);
    }
}

// ---------------------------------------------------------------------------------------------
// Shared fixture: a real PoolManager, a factory launch (token + mined hook + pool + position in
// one transaction), an identical hookless mirror pool for reference amounts, a swap router and
// funded users. setUp leaves the launch block so the lagged reserve is the seeded position.
// ---------------------------------------------------------------------------------------------
abstract contract IMDOFixture is Asserts {
    Vm constant vm = Vm(address(uint160(uint256(keccak256("hevm cheat code")))));
    address constant TREASURY = 0xb1eC9d1C36974d05eb9889eBf8A150b05791E559;
    uint256 constant PPM = 1_000_000;
    uint128 constant LIQUIDITY = 1e22;
    uint256 constant INITIAL_SUPPLY = 1_000_000_000 ether;
    bytes32 constant FEE_TOPIC = keccak256("HookFeeCharged(address,uint24,uint256,address,uint256)");
    bytes constant REJECT_ETH = hex"60006000fd"; // PUSH1 0 PUSH1 0 REVERT
    bytes constant BURN_GAS = hex"5b600056"; // JUMPDEST PUSH1 0 JUMP

    IV4 manager;
    LaunchFactory factory;
    IMDOToken token;
    IMDOFeeHook hook;
    Router router;
    MerkleDistributor distributor;
    IMDPoolKey key;
    IMDPoolKey mirror;

    address alice = address(0xA11CE);
    address bob = address(0xB0B);
    address carol = address(0xCA201);
    address payeeA = address(0x9A);
    address payeeB = address(0x9B);
    address[4] swarm = [address(0x5001), address(0x5002), address(0x5003), address(0x5004)];
    uint256[4] swarmAmounts = [uint256(1e21), 2e21, 3e21, 4e21];
    bytes32[4] leaves;
    bytes32 root;

    function _deployManager() internal returns (IV4) {
        bytes memory code = abi.encodePacked(new V4Code().creationCode(), abi.encode(address(this)));
        address a;
        assembly ("memory-safe") {
            a := create(0, add(code, 0x20), mload(code))
        }
        require(a != address(0), "manager deploy");
        return IV4(a);
    }

    function _pair(bytes32 x, bytes32 y) internal pure returns (bytes32) {
        return x < y ? keccak256(abi.encodePacked(x, y)) : keccak256(abi.encodePacked(y, x));
    }

    function _buildTree() internal {
        for (uint256 i; i < 4; ++i) {
            leaves[i] = keccak256(abi.encodePacked(i, swarm[i], swarmAmounts[i]));
        }
        root = _pair(_pair(leaves[0], leaves[1]), _pair(leaves[2], leaves[3]));
    }

    function _proof(uint256 i) internal view returns (bytes32[] memory p) {
        p = new bytes32[](2);
        p[0] = leaves[i ^ 1];
        p[1] = i < 2 ? _pair(leaves[2], leaves[3]) : _pair(leaves[0], leaves[1]);
    }

    /// @dev Launch through the factory. `tl/tu` shape the seeded position (full range by default).
    function _launch(int24 tl, int24 tu, bool withMirror, bool leaveLaunchBlock) internal {
        manager = _deployManager();
        factory = new LaunchFactory(manager, payeeA, payeeB);
        vm.deal(address(factory), 3e22);
        _buildTree();
        factory.launch(
            LaunchFactory.LaunchParams({
                fee: 3000,
                tickLower: tl,
                tickUpper: tu,
                liquidity: LIQUIDITY,
                withMirror: withMirror,
                merkleRoot: root,
                distributorAmount: 1e22,
                publicHolder: address(this)
            })
        );
        token = factory.token();
        hook = factory.hook();
        distributor = factory.distributor();
        key = factory.hookedKey();
        mirror = factory.mirrorKey();
        router = new Router(manager, token);
        address[3] memory users = [alice, bob, carol];
        for (uint256 i; i < 3; ++i) {
            token.transfer(users[i], 1e25);
            vm.deal(users[i], 1e24);
            vm.prank(users[i]);
            token.approve(address(router), type(uint256).max);
        }
        vm.label(address(hook), "hook");
        vm.label(address(manager), "manager");
        if (leaveLaunchBlock) vm.roll(block.number + 1);
    }

    function _swap(address user, IMDPoolKey memory k, bool zeroForOne, int256 amountSpecified, uint256 value)
        internal
        returns (int256)
    {
        Action[] memory a = new Action[](1);
        a[0] = Action(0, zeroForOne ? int256(1) : int256(0), amountSpecified, 0);
        vm.prank(user, user);
        return router.execute{value: value}(k, a)[0];
    }

    function _execute(address user, IMDPoolKey memory k, Action[] memory a, uint256 value)
        internal
        returns (int256[] memory)
    {
        vm.prank(user, user);
        return router.execute{value: value}(k, a);
    }

    /// @dev Same exact-input sell on the mirror pool (bob) then the hooked pool (alice).
    function _sellExactInBoth(uint256 size) internal returns (uint256 gross, uint256 fee) {
        int256 m = _swap(bob, mirror, false, -int256(size), 0);
        uint256 treasuryBefore = TREASURY.balance;
        int256 h = _swap(alice, key, false, -int256(size), 0);
        eq(V4.amount1(m), -int256(size), "mirror token in");
        eq(V4.amount1(h), -int256(size), "hooked token in");
        gross = uint256(V4.amount0(m));
        fee = gross - uint256(V4.amount0(h));
        eq(TREASURY.balance - treasuryBefore, fee, "treasury receives the fee");
    }

    /// @dev Same exact-output sell on both pools; returns the settled token input and token fee.
    function _sellExactOutBoth(uint256 ethOut) internal returns (uint256 tokenIn, uint256 fee) {
        int256 m = _swap(bob, mirror, false, int256(ethOut), 0);
        uint256 treasuryBefore = TREASURY.balance;
        uint256 supplyBefore = token.totalSupply();
        int256 h = _swap(alice, key, false, int256(ethOut), 0);
        eq(V4.amount0(m), int256(ethOut), "mirror eth out");
        eq(V4.amount0(h), int256(ethOut), "hooked eth out is the requested amount");
        tokenIn = uint256(-V4.amount1(m));
        fee = uint256(-V4.amount1(h)) - tokenIn;
        eq(TREASURY.balance, treasuryBefore, "exact-output sells send no ETH to the treasury");
        eq(supplyBefore - token.totalSupply(), fee, "token-side fee is burned");
    }

    function _feesInLogs(Vm.Log[] memory logs)
        internal
        view
        returns (uint256 ethFee, uint256 tokenFee, uint24 maxRate)
    {
        for (uint256 i; i < logs.length; ++i) {
            if (logs[i].emitter != address(hook) || logs[i].topics[0] != FEE_TOPIC) continue;
            (uint24 rate,, address currency, uint256 amount) =
                abi.decode(logs[i].data, (uint24, uint256, address, uint256));
            if (rate > maxRate) maxRate = rate;
            if (currency == address(0)) ethFee += amount;
            else tokenFee += amount;
        }
    }

    function _assertNoRawCustody() internal view {
        eq(address(hook).balance, 0, "hook holds raw ETH");
        eq(token.balanceOf(address(hook)), 0, "hook holds raw tokens");
        eq(manager.balanceOf(address(hook), 0), hook.accruedETH(), "eth claims == accruedETH");
        eq(
            manager.balanceOf(address(hook), uint256(uint160(address(token)))),
            hook.accruedToken(),
            "token claims == accruedToken"
        );
    }

    /// @dev With identical hooked and mirror pools the manager's token balance is twice the hook's reserve.
    function _assertReserveReconciles() internal view {
        uint256 claims = manager.balanceOf(address(hook), uint256(uint160(address(token))));
        eq(
            2 * hook.liveReserve(),
            token.balanceOf(address(manager)) - manager.protocolFeesAccrued(address(token)) - claims,
            "liveReserve reconciles with manager inventory"
        );
    }

    function _ceilPct(uint256 reserve, uint256 bps) internal pure returns (uint256) {
        return (reserve * bps + 9_999) / 10_000;
    }
}

// ---------------------------------------------------------------------------------------------
// Hook behaviour against the real PoolManager with the launch position in place.
// ---------------------------------------------------------------------------------------------
contract IMDOHookTest is IMDOFixture {
    function setUp() public {
        _launch(V4.TICK_LOWER, V4.TICK_UPPER, true, true);
    }

    // ----- binding, permissions, immutability -----

    function test_launchBindsOnePoolAndTracksSeededReserve() public view {
        ok(hook.initialized(), "initialized");
        eq(hook.poolId(), V4.poolId(key), "poolId");
        eq(hook.token(), address(token), "token");
        eq(address(hook.poolManager()), address(manager), "manager");
        eq(uint256(uint160(address(hook)) & 0x3fff), 0x25d4, "address bits");
        eq(uint256(hook.FLAGS()), 0x25d4, "FLAGS");
        eq(hook.TREASURY(), TREASURY, "treasury");
        eq(uint256(hook.MAX_FEE_PPM()), 20_000, "cap");
        // The seeded reserve is the token side of the launch position and nothing else.
        uint256 seeded = token.balanceOf(address(manager)) / 2;
        eq(hook.liveReserve(), seeded, "liveReserve is the seeded token inventory");
        eq(hook.reserveSnapshot(), seeded, "next block uses the seeded reserve");
        gt(seeded, 0, "seeded");
        _assertReserveReconciles();
    }

    function test_permissionsMatchAddressBits() public view {
        IMDHookPermissions memory p = hook.getHookPermissions();
        uint160 bits;
        if (p.beforeInitialize) bits |= 1 << 13;
        if (p.afterInitialize) bits |= 1 << 12;
        if (p.beforeAddLiquidity) bits |= 1 << 11;
        if (p.afterAddLiquidity) bits |= 1 << 10;
        if (p.beforeRemoveLiquidity) bits |= 1 << 9;
        if (p.afterRemoveLiquidity) bits |= 1 << 8;
        if (p.beforeSwap) bits |= 1 << 7;
        if (p.afterSwap) bits |= 1 << 6;
        if (p.beforeDonate) bits |= 1 << 5;
        if (p.afterDonate) bits |= 1 << 4;
        if (p.beforeSwapReturnDelta) bits |= 1 << 3;
        if (p.afterSwapReturnDelta) bits |= 1 << 2;
        if (p.afterAddLiquidityReturnDelta) bits |= 1 << 1;
        if (p.afterRemoveLiquidityReturnDelta) bits |= 1;
        eq(uint256(bits), uint256(uint160(address(hook)) & 0x3fff), "permissions vs address");
        ok(p.afterSwap && p.afterSwapReturnDelta && p.beforeInitialize, "required callbacks");
        ok(!p.beforeSwapReturnDelta && !p.afterAddLiquidityReturnDelta && !p.afterRemoveLiquidityReturnDelta, "no NoOp");
    }

    function test_runtimeCodeHasNoEscapeHatch() public view {
        bytes memory code = address(hook).code;
        ok(code.length > 0 && code.length <= 24_576, "size");
        assertNoEscapeOpcodes(code, "hook");
    }

    function test_secondPoolWithThisHookIsRejected() public {
        IMDPoolKey memory other = IMDPoolKey(address(0), address(token), 500, 10, address(hook));
        vm.expectRevert();
        manager.initialize(other, V4.SQRT_1_1);
        // A second token paired with this hook is refused as well.
        IMDOToken another = new IMDOToken();
        IMDPoolKey memory foreign = IMDPoolKey(address(0), address(another), 3000, 60, address(hook));
        vm.expectRevert();
        manager.initialize(foreign, V4.SQRT_1_1);
        ok(hook.poolId() == V4.poolId(key), "binding unchanged");
    }

    function test_callbacksRefuseCallersOtherThanTheManager() public {
        IMDSwapParams memory sp = IMDSwapParams(false, -1 ether, V4.MAX_SQRT - 1);
        IMDModifyLiquidityParams memory mp = IMDModifyLiquidityParams(-60, 60, 1 ether, 0);
        bytes[7] memory calls = [
            abi.encodeCall(hook.beforeInitialize, (address(this), key, V4.SQRT_1_1)),
            abi.encodeCall(hook.afterAddLiquidity, (address(this), key, mp, 0, 0, "")),
            abi.encodeCall(hook.afterRemoveLiquidity, (address(this), key, mp, 0, 0, "")),
            abi.encodeCall(hook.beforeSwap, (address(this), key, sp, "")),
            abi.encodeCall(hook.afterSwap, (address(this), key, sp, -1 ether, "")),
            abi.encodeCall(hook.afterDonate, (address(this), key, 0, 1 ether, "")),
            abi.encodeCall(hook.unlockCallback, (""))
        ];
        for (uint256 i; i < calls.length; ++i) {
            vm.prank(carol);
            (bool success,) = address(hook).call(calls[i]);
            ok(!success, "callback accepted a non-manager caller");
        }
        // Even the manager cannot drive the harvest callback outside a harvest.
        vm.prank(address(manager));
        vm.expectRevert(bytes("no harvest"));
        hook.unlockCallback("");
        // And cannot re-bind the pool.
        vm.prank(address(manager));
        vm.expectRevert(IMDOFeeHook.InvalidPool.selector);
        hook.beforeInitialize(address(this), key, V4.SQRT_1_1);
        eq(hook.liveReserve(), hook.reserveSnapshot(), "state untouched");
    }

    /// forge-config: default.fuzz.runs = 300
