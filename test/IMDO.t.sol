        int256 m = _swap(bob, mirror, true, -1e20, 1e20);
        int256 h = _swap(alice, key, true, -1e20, 1e20);
        eq(h, m, "exact-in buy identical to the hookless pool");
        gt(uint256(V4.amount1(h)), 0, "tokens received");
        // exact output: 5% of the reserve
        uint256 want = hook.reserveSnapshot() / 20;
        m = _swap(bob, mirror, true, int256(want), 1e23);
        h = _swap(alice, key, true, int256(want), 1e23);
        eq(h, m, "exact-out buy identical to the hookless pool");
        eq(V4.amount1(h), int256(want), "exact tokens out");
        eq(TREASURY.balance, treasuryBefore, "no ETH to the treasury on buys");
        eq(hook.accruedETH() + hook.accruedToken(), 0, "no claims on buys");
