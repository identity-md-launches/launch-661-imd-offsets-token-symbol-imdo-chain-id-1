    function test_treasuryReceivesExactlyTheFeeAndTheSellerTheRest() public {
        uint256 size = _ceilPct(hook.reserveSnapshot(), 500);
        uint256 aliceEthBefore = alice.balance;
        (uint256 gross, uint256 fee) = _sellExactInBoth(size);
        eq(fee, gross * 20_000 / PPM, "2%");
        eq(TREASURY.balance, fee, "treasury balance is exactly the fee");
        eq(alice.balance - aliceEthBefore, gross - fee, "seller keeps gross minus fee");
        eq(hook.accruedETH(), 0, "paid directly, nothing accrued");
        _assertNoRawCustody();
    }

    function test_splitExactInputSellsAreBilledCumulatively() public {
        uint256 reserve = hook.reserveSnapshot();
        uint256 t1 = _ceilPct(reserve, 100);
        Action[] memory legs = new Action[](2);
        legs[0] = Action(0, 0, -int256(t1 / 2), 0);
        legs[1] = Action(0, 0, -int256(t1 - t1 / 2), 0);
        int256[] memory m = _execute(bob, mirror, legs, 0);
        uint256 treasuryBefore = TREASURY.balance;
        int256[] memory h = _execute(alice, key, legs, 0);
        uint256 g1 = uint256(V4.amount0(m[0]));
        uint256 g2 = uint256(V4.amount0(m[1]));
        uint256 expectedTotal = (g1 + g2) * 5_000 / PPM;
        eq(V4.amount0(h[0]), int256(g1), "first leg below 1%: no fee yet");
        eq(uint256(V4.amount0(h[1])), g2 - expectedTotal, "second leg carries the cumulative 0.5% bill");
        eq(TREASURY.balance - treasuryBefore, expectedTotal, "treasury got the cumulative bill");
        gt(expectedTotal, 0, "bill positive");
        // The same two legs as separate transactions each stay below 1% and pay nothing.
        (, uint256 feeA) = _sellExactInBoth(t1 / 2);
        (, uint256 feeB) = _sellExactInBoth(t1 - t1 / 2);
        eq(feeA + feeB, 0, "separate transactions are billed separately");
        _assertNoRawCustody();
    }

    function test_threeLegSplitCrossesTwoBrackets() public {
        uint256 reserve = hook.reserveSnapshot();
        uint256 t1 = _ceilPct(reserve, 100);
        Action[] memory legs = new Action[](3);
        for (uint256 i; i < 3; ++i) {
            legs[i] = Action(0, 0, -int256(t1), 0);
        }
        int256[] memory m = _execute(bob, mirror, legs, 0);
        uint256 treasuryBefore = TREASURY.balance;
        int256[] memory h = _execute(alice, key, legs, 0);
        uint256 gross;
        uint256 received;
        for (uint256 i; i < 3; ++i) {
            gross += uint256(V4.amount0(m[i]));
            received += uint256(V4.amount0(h[i]));
        }
        // cumulative 3 * ceil(1%) >= 3% so the final bracket is 1% on all proceeds
        eq(uint256(hook.feeRate(3 * t1, reserve)), 10_000, "final bracket");
        eq(gross - received, gross * 10_000 / PPM, "total fee = all proceeds * final rate");
        eq(TREASURY.balance - treasuryBefore, gross - received, "treasury");
        le(uint256(V4.amount0(h[0])), uint256(V4.amount0(m[0])), "leg 1 billed at 0.5%");
        eq(uint256(V4.amount0(m[0])) - uint256(V4.amount0(h[0])), uint256(V4.amount0(m[0])) * 5_000 / PPM, "leg 1");
    }

    function test_mixedModeSplitIsBilledCumulatively() public {
        uint256 reserve = hook.reserveSnapshot();
        uint256 t1 = _ceilPct(reserve, 100);
        Action[] memory legs = new Action[](2);
        legs[0] = Action(0, 0, -int256(t1 - 1), 0); // exact input just under 1%
        legs[1] = Action(0, 0, int256(reserve / 1000), 0); // exact output pushes past 1%
        int256[] memory m = _execute(bob, mirror, legs, 0);
        uint256 supplyBefore = token.totalSupply();
        uint256 treasuryBefore = TREASURY.balance;
        int256[] memory h = _execute(alice, key, legs, 0);
        uint256 g1 = uint256(V4.amount0(m[0]));
        uint256 g2 = uint256(V4.amount0(m[1]));
        uint256 tokenIn2 = uint256(-V4.amount1(m[1]));
        eq(h[0], m[0], "first leg untouched");
        eq(uint256(hook.feeRate(t1 - 1 + tokenIn2, reserve)), 5_000, "cumulative bracket");
        uint256 expectedTokens = (g1 + g2) * 5_000 * tokenIn2 / (g2 * PPM);
        eq(uint256(-V4.amount1(h[1])) - tokenIn2, expectedTokens, "catch-up bill converted into tokens");
        eq(supplyBefore - token.totalSupply(), expectedTokens, "burned");
        eq(TREASURY.balance, treasuryBefore, "no ETH fee on the exact-output leg");
        _assertNoRawCustody();
        _assertReserveReconciles();
    }

    // ----- per-leg bound: a leg is never billed more than its own size -----
    // A dust leg that crosses a bracket owes a catch-up on everything sold before it. The revised
    // hook caps that leg at its own output (exact input) or its own input (exact output), so the
    // swapper's ETH delta for a sell leg is never negative, and carries the rest to the next leg.

    function test_dustCrossingLegIsBoundedToItsOwnOutputAndTheNextLegPaysTheRest() public {
        uint256 reserve = hook.reserveSnapshot();
        uint256 t1 = _ceilPct(reserve, 100);
        Action[] memory legs = new Action[](3);
        legs[0] = Action(0, 0, -int256(t1 - 1), 0); // just under 1%: free so far
        legs[1] = Action(0, 0, -int256(uint256(1e12)), 0); // dust crosses into the 0.5% bracket
        legs[2] = Action(0, 0, -int256(t1), 0); // ordinary leg, cumulative still under 3%
        int256[] memory m = _execute(bob, mirror, legs, 0);
        uint256 treasuryBefore = TREASURY.balance;
        vm.recordLogs();
        int256[] memory h = _execute(alice, key, legs, 0);
        (uint256 ethFee, uint256 tokenFee, uint24 maxRate) = _feesInLogs(vm.getRecordedLogs());
        uint256 g1 = uint256(V4.amount0(m[0]));
        uint256 g2 = uint256(V4.amount0(m[1]));
        uint256 g3 = uint256(V4.amount0(m[2]));
        eq(uint256(hook.feeRate(2 * t1 - 1 + 1e12, reserve)), 5_000, "the whole batch sits in the 0.5% bracket");
        gt((g1 + g2) * 5_000 / PPM, g2, "the catch-up bill exceeds the dust leg's entire output");
        eq(h[0], m[0], "leg 1 untouched");
        eq(V4.amount0(h[1]), 0, "leg 2 surrenders exactly its own output: the ETH leg is never negative");
        eq(V4.amount1(h[1]), V4.amount1(m[1]), "leg 2 token input unchanged");
        uint256 total = (g1 + g2 + g3) * 5_000 / PPM;
        eq(g3 - uint256(V4.amount0(h[2])), total - g2, "leg 3 pays the carried remainder plus its own share");
        eq(ethFee, total, "the cumulative bill is fully collected by the end of the transaction");
        eq(tokenFee, 0, "no token-side fee on exact-input legs");
        eq(uint256(maxRate), 5_000, "rate");
        eq(TREASURY.balance - treasuryBefore, total, "treasury receives the whole bill in ETH");
        _assertNoRawCustody();
    }

    function test_dustCrossingLegAsTheLastLegLeavesABoundedRemainderThatDoesNotCarryAcrossTransactions() public {
        uint256 reserve = hook.reserveSnapshot();
        uint256 t1 = _ceilPct(reserve, 100);
        Action[] memory legs = new Action[](2);
        legs[0] = Action(0, 0, -int256(t1 - 1), 0);
        legs[1] = Action(0, 0, -int256(uint256(1e12)), 0);
        int256[] memory m = _execute(bob, mirror, legs, 0);
        uint256 treasuryBefore = TREASURY.balance;
        int256[] memory h = _execute(alice, key, legs, 0);
        uint256 g1 = uint256(V4.amount0(m[0]));
        uint256 g2 = uint256(V4.amount0(m[1]));
        eq(h[0], m[0], "leg 1 untouched");
        eq(V4.amount0(h[1]), 0, "the last dust leg pays its whole output and nothing more");
        eq(TREASURY.balance - treasuryBefore, g2, "treasury got exactly that output");
        gt((g1 + g2) * 5_000 / PPM - g2, 0, "part of the catch-up stays uncollected: the documented trade-off");
        // Not cheaper than separate transactions: alone, each of the two sells pays nothing at all.
        (, uint256 feeA) = _sellExactInBoth(t1 - 1);
        (, uint256 feeB) = _sellExactInBoth(1e12);
        eq(feeA + feeB, 0, "standalone legs are free");
        // The remainder is transaction-local: a later transaction of the same origin starts clean.
        (, uint256 feeC) = _sellExactInBoth(t1 - 1);
        eq(feeC, 0, "a new transaction starts with an empty bill");
        _assertNoRawCustody();
    }

    function test_exactOutputDustCrossingLegIsBoundedToItsOwnInputAndTheNextLegPaysTheRest() public {
        uint256 reserve = hook.reserveSnapshot();
        uint256 t1 = _ceilPct(reserve, 100);
        Action[] memory legs = new Action[](3);
        legs[0] = Action(0, 0, -int256(t1 - 1), 0); // exact input, just under 1%
        legs[1] = Action(0, 0, int256(uint256(1e9)), 0); // exact output of 1 gwei crosses into 0.5%
        legs[2] = Action(0, 0, int256(reserve / 1000), 0); // exact output, ordinary size
        int256[] memory m = _execute(bob, mirror, legs, 0);
        uint256 supplyBefore = token.totalSupply();
        uint256 treasuryBefore = TREASURY.balance;
        int256[] memory h = _execute(alice, key, legs, 0);
        eq(
            uint256(hook.feeRate(uint256(-(V4.amount1(m[0]) + V4.amount1(m[1]) + V4.amount1(m[2]))), reserve)),
            5_000,
            "the whole batch sits in the 0.5% bracket"
        );
        eq(h[0], m[0], "leg 1 untouched");
        (uint256 fee2, uint256 fee3) = _assertBoundedExactOutputLegs(m, h);
        eq(supplyBefore - token.totalSupply(), fee2 + fee3, "both token fees burned");
        eq(TREASURY.balance, treasuryBefore, "exact-output legs send no ETH");
        _assertNoRawCustody();
        _assertReserveReconciles();
    }

    /// @dev Legs 2 and 3 of the exact-output dust scenario: mirror deltas `m`, hooked deltas `h`.
    function _assertBoundedExactOutputLegs(int256[] memory m, int256[] memory h)
        internal
        pure
        returns (uint256 fee2, uint256 fee3)
    {
        uint256 g1 = uint256(V4.amount0(m[0]));
        uint256 g2 = uint256(V4.amount0(m[1]));
        uint256 g3 = uint256(V4.amount0(m[2]));
        uint256 in2 = uint256(-V4.amount1(m[1]));
        uint256 in3 = uint256(-V4.amount1(m[2]));
        eq(g2, 1e9, "leg 2 output as requested");
        gt((g1 + g2) * 5_000 * in2 / (g2 * PPM), in2, "an unbounded catch-up would exceed the leg's own input");
        eq(V4.amount0(h[1]), int256(g2), "leg 2 delivers the requested ETH");
        fee2 = uint256(-V4.amount1(h[1])) - in2;
        eq(fee2, in2, "leg 2 fee is bounded to its own token input");
        // The bounded fee is credited at the leg's exchange ratio, exactly g2 * PPM, so leg 3 owes the rest.
        fee3 = ((g1 + g2 + g3) * 5_000 - g2 * PPM) * in3 / (g3 * PPM);
        le(fee3, in3, "leg 3 fee within its own input");
        eq(V4.amount0(h[2]), int256(g3), "leg 3 delivers the requested ETH");
        eq(uint256(-V4.amount1(h[2])) - in3, fee3, "leg 3 pays the remainder converted at its own price");
    }

    /// forge-config: default.fuzz.runs = 96
    function testFuzz_oneTransactionSplitNeverPaysLessThanPerLegBracketsNorMoreThanTheFinalBracket(
        uint256 a,
        uint256 b,
        uint256 c
    ) public {
        uint256 reserve = hook.reserveSnapshot();
        uint256[3] memory sizes = [bound(a, 1, reserve / 40), bound(b, 1, reserve / 40), bound(c, 1, reserve / 40)];
        Action[] memory legs = new Action[](3);
        for (uint256 i; i < 3; ++i) {
            legs[i] = Action(0, 0, -int256(sizes[i]), 0);
        }
        int256[] memory m = _execute(bob, mirror, legs, 0);
        uint256 treasuryBefore = TREASURY.balance;
        int256[] memory h = _execute(alice, key, legs, 0);
        uint256 gross;
        uint256 paid;
        uint256 perLeg;
        for (uint256 i; i < 3; ++i) {
            ok(V4.amount0(h[i]) >= 0, "a sell leg never ends with a negative ETH delta");
            eq(V4.amount1(h[i]), V4.amount1(m[i]), "token input settled as requested");
            uint256 g = uint256(V4.amount0(m[i]));
            gross += g;
            paid += g - uint256(V4.amount0(h[i]));
            perLeg += g * hook.feeRate(sizes[i], reserve) / PPM;
        }
        uint256 finalRate = hook.feeRate(sizes[0] + sizes[1] + sizes[2], reserve);
        ok(paid >= perLeg, "splitting inside one transaction never beats billing each leg at its own bracket");
        le(paid, gross * finalRate / PPM, "never more than the final bracket on all proceeds");
        eq(TREASURY.balance - treasuryBefore, paid, "treasury");
        _assertNoRawCustody();
    }

    // ----- reserve snapshot -----

    function test_sameTransactionLiquidityInflationDoesNotLowerTheBracket() public {
        uint256 reserve = hook.reserveSnapshot();
        uint256 size = _ceilPct(reserve, 500);
        Action[] memory a = new Action[](2);
        a[0] = Action(1, V4.TICK_LOWER, V4.TICK_UPPER, int256(uint256(LIQUIDITY)) * 9);
        a[1] = Action(0, 0, -int256(size), 0);
        int256[] memory m = _execute(bob, mirror, a, 1e23);
        uint256 treasuryBefore = TREASURY.balance;
        int256[] memory h = _execute(alice, key, a, 1e23);
        uint256 gross = uint256(V4.amount0(m[1]));
        eq(uint256(V4.amount0(m[1])) - uint256(V4.amount0(h[1])), gross * 20_000 / PPM, "still 2%");
        eq(TREASURY.balance - treasuryBefore, gross * 20_000 / PPM, "treasury");
        gt(hook.liveReserve(), 9 * reserve, "live reserve did inflate");
        eq(hook.reserveSnapshot(), reserve, "snapshot unchanged inside the block");
        // One block later the same size is 0.5% of the inflated reserve and pays nothing.
        vm.roll(block.number + 1);
        (, uint256 fee) = _sellExactInBoth(size);
        eq(fee, 0, "lag is exactly one block");
        _assertReserveReconciles();
    }

    function test_sameTransactionDonationDoesNotLowerTheBracket() public {
        uint256 reserve = hook.reserveSnapshot();
        uint256 size = _ceilPct(reserve, 300);
        Action[] memory a = new Action[](2);
        a[0] = Action(2, 0, int256(reserve * 20), 0);
        a[1] = Action(0, 0, -int256(size), 0);
        int256[] memory m = _execute(bob, mirror, a, 0);
        int256[] memory h = _execute(alice, key, a, 0);
        uint256 gross = uint256(V4.amount0(m[1]));
        eq(gross - uint256(V4.amount0(h[1])), gross * 10_000 / PPM, "still 1% after a 20x donation");
        eq(hook.liveReserve(), reserve + size + reserve * 20 - 0, "donation counted in live reserve");
        _assertReserveReconciles();
    }

    function test_sameBlockEarlierTransactionsDoNotChangeTheSnapshot() public {
        uint256 reserve = hook.reserveSnapshot();
        // a big buy and a liquidity add in earlier transactions of the same block
        _swap(bob, mirror, true, -2e21, 2e21);
        _swap(carol, key, true, -2e21, 2e21);
        Action[] memory a = new Action[](1);
        a[0] = Action(1, V4.TICK_LOWER, V4.TICK_UPPER, int256(uint256(LIQUIDITY)));
        _execute(bob, mirror, a, 2e22);
        _execute(carol, key, a, 2e22);
        eq(hook.reserveSnapshot(), reserve, "snapshot");
        (uint256 gross, uint256 fee) = _sellExactInBoth(_ceilPct(reserve, 500));
        eq(fee, gross * 20_000 / PPM, "2% against the lagged reserve");
    }

    // ----- fallbacks, harvest -----

    function test_treasuryRejectingEthFallsBackToClaimsAndNeverBlocksTheSell() public {
        vm.etch(TREASURY, REJECT_ETH);
        uint256 size = _ceilPct(hook.reserveSnapshot(), 500);
        int256 m = _swap(bob, mirror, false, -int256(size), 0);
        int256 h = _swap(alice, key, false, -int256(size), 0);
        uint256 gross = uint256(V4.amount0(m));
        uint256 fee = gross - uint256(V4.amount0(h));
        eq(fee, gross * 20_000 / PPM, "fee still charged");
        eq(TREASURY.balance, 0, "treasury could not receive");
        eq(hook.accruedETH(), fee, "accrued as a claim");
        eq(manager.balanceOf(address(hook), 0), fee, "ERC-6909 claim backs it");
        _assertNoRawCustody();
        // Harvest cannot deliver while the treasury rejects, and nothing is lost.
        vm.expectRevert();
        hook.harvest();
        eq(hook.accruedETH(), fee, "claim intact");
        // Once the treasury accepts ETH anyone can harvest; ETH goes only to the treasury.
        vm.etch(TREASURY, "");
        uint256 carolBefore = carol.balance;
        vm.prank(carol, carol);
        hook.harvest();
        eq(TREASURY.balance, fee, "harvest paid the treasury");
        eq(carol.balance, carolBefore, "harvester gets nothing");
        eq(hook.accruedETH(), 0, "accrual cleared");
        eq(manager.balanceOf(address(hook), 0), 0, "claim burned");
        _assertNoRawCustody();
    }

    function test_gasBurningTreasuryCannotBlockSells() public {
        vm.etch(TREASURY, BURN_GAS);
        uint256 size = _ceilPct(hook.reserveSnapshot(), 500);
        int256 m = _swap(bob, mirror, false, -int256(size), 0);
        int256 h = _swap(alice, key, false, -int256(size), 0);
        uint256 fee = uint256(V4.amount0(m)) - uint256(V4.amount0(h));
        eq(fee, uint256(V4.amount0(m)) * 20_000 / PPM, "fee charged");
        eq(hook.accruedETH(), fee, "accrued instead of paid");
        _assertNoRawCustody();
    }

    function test_harvestWithNothingAccruedIsANoOp() public {
        uint256 treasuryBefore = TREASURY.balance;
        vm.prank(carol, carol);
        hook.harvest();
        eq(TREASURY.balance, treasuryBefore, "nothing moved");
        eq(token.totalSupply(), INITIAL_SUPPLY, "nothing burned");
    }

    /// forge-config: default.fuzz.runs = 200
    function testFuzz_sellsAreNeverBlocked(uint256 size, bool exactInput, bool treasuryRejects) public {
        uint256 reserve = hook.reserveSnapshot();
        size = bound(size, 1, reserve / 2);
        if (treasuryRejects) vm.etch(TREASURY, REJECT_ETH);
        uint256 ethBefore = alice.balance;
        uint256 tokBefore = token.balanceOf(alice);
        int256 amountSpecified = exactInput ? -int256(size) : int256(size / 2 + 1);
        _swap(bob, mirror, false, amountSpecified, 0);
        int256 d = _swap(alice, key, false, amountSpecified, 0);
        ok(V4.amount1(d) <= 0 && V4.amount0(d) >= 0, "sell direction");
        eq(alice.balance - ethBefore, uint256(V4.amount0(d)), "ETH received as settled");
        eq(tokBefore - token.balanceOf(alice), uint256(-V4.amount1(d)), "tokens paid as settled");
        _assertNoRawCustody();
        _assertReserveReconciles();
    }

    // ----- factory position, LP fees, swarm -----

    function _tradeBothPools() internal {
        uint256 reserve = hook.reserveSnapshot();
        for (uint256 i; i < 3; ++i) {
            _sellExactInBoth(_ceilPct(reserve, 400));
            _sellExactOutBoth(reserve / 50);
            _swap(bob, mirror, true, -1e20, 1e20);
            _swap(alice, key, true, -1e20, 1e20);
            _swap(bob, mirror, true, int256(reserve / 100), 1e22);
            _swap(alice, key, true, int256(reserve / 100), 1e22);
        }
    }

    function test_factoryPoolFeeAccountingAndDistributionUnaffectedByTheHook() public {
        _tradeBothPools();
        gt(TREASURY.balance, 0, "hook fees were charged along the way");
        (uint256 g0, uint256 g1) = V4.feeGrowthGlobals(manager, key);
        (uint256 m0, uint256 m1) = V4.feeGrowthGlobals(manager, mirror);
        eq(g0, m0, "ETH fee growth identical to the hookless pool");
        eq(g1, m1, "token fee growth identical to the hookless pool");
        gt(g0, 0, "LP fees accrued");
        (uint160 p,,,) = V4.slot0(manager, key);
        (uint160 pm,,,) = V4.slot0(manager, mirror);
        eq(uint256(p), uint256(pm), "price identical");
        uint256 factoryEthBefore = address(factory).balance;
        (int256 hookedFees, int256 mirrorFees) = factory.collect();
        eq(hookedFees, mirrorFees, "collected LP fees identical");
        gt(uint256(V4.amount0(hookedFees)), 0, "ETH LP fees");
        gt(uint256(V4.amount1(hookedFees)), 0, "token LP fees");
        eq(
            address(factory).balance - factoryEthBefore,
            2 * uint256(V4.amount0(hookedFees)),
            "factory holds both pools' fees"
        );
        // The factory pays its own payees exactly as before: the hook took nothing from this stream.
        uint256 eth = address(factory).balance;
        uint256 tok = token.balanceOf(address(factory));
        factory.distribute();
        eq(payeeA.balance, eth * 60 / 100, "payee A ETH");
        eq(payeeB.balance, eth - eth * 60 / 100, "payee B ETH");
        eq(token.balanceOf(payeeA), tok * 60 / 100, "payee A tokens");
        eq(token.balanceOf(payeeB), tok - tok * 60 / 100, "payee B tokens");
        // Withdrawal of the launch position is not gated or altered either.
        (int256 wh, int256 wm) = factory.withdraw(LIQUIDITY / 2);
        eq(wh, wm, "withdrawal identical");
        eq(
            uint256(V4.positionLiquidity(manager, key, address(factory), V4.TICK_LOWER, V4.TICK_UPPER, 0)),
            LIQUIDITY / 2,
            "position"
        );
        _assertReserveReconciles();
        _assertNoRawCustody();
    }

    function test_swarmMerkleClaimsAreUntaxedAndUnaffected() public {
        _tradeBothPools();
        uint256 supply = token.totalSupply();
        bytes32[] memory proof1 = _proof(1);
        vm.expectRevert(bytes("proof"));
        distributor.claim(1, swarm[1], swarmAmounts[1] + 1, proof1);
        for (uint256 i; i < 4; ++i) {
            vm.prank(swarm[i], swarm[i]);
            distributor.claim(i, swarm[i], swarmAmounts[i], _proof(i));
            eq(token.balanceOf(swarm[i]), swarmAmounts[i], "claim received in full");
        }
        eq(token.totalSupply(), supply, "claims move tokens, nothing is burned or minted");
        eq(token.balanceOf(address(distributor)), 1e22 - 1e21 - 2e21 - 3e21 - 4e21, "distributor remainder");
        bytes32[] memory proof0 = _proof(0);
        vm.expectRevert(bytes("claimed"));
        distributor.claim(0, swarm[0], swarmAmounts[0], proof0);
        // A claimant can trade through the hooked pool like anyone else.
        vm.prank(swarm[3]);
        token.approve(address(router), type(uint256).max);
        int256 d = _swap(swarm[3], key, false, -int256(swarmAmounts[3]), 0);
        gt(uint256(V4.amount0(d)), 0, "sold");
    }

    function test_protocolFeesAreExcludedFromTheReserve() public {
        manager.setProtocolFeeController(address(this));
        manager.setProtocolFee(key, 1000 | (1000 << 12));
        manager.setProtocolFee(mirror, 1000 | (1000 << 12));
        uint256 size = _ceilPct(hook.reserveSnapshot(), 200);
        uint256 reserveBefore = hook.liveReserve();
        uint256 accruedBefore = manager.protocolFeesAccrued(address(token));
        (uint256 gross, uint256 fee) = _sellExactInBoth(size);
        uint256 protocolTotal = manager.protocolFeesAccrued(address(token)) - accruedBefore;
        gt(protocolTotal, 0, "protocol fee charged on token input");
        eq(hook.liveReserve(), reserveBefore + size - protocolTotal / 2, "reserve excludes this pool's protocol fee");
        eq(fee, gross * 5_000 / PPM, "hook fee unchanged by protocol fee");
        _assertReserveReconciles();
        manager.collectProtocolFees(address(this), address(token), protocolTotal);
        _assertReserveReconciles();
    }
}

