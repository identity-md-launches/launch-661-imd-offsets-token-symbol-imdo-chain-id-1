            _ceilPct(reserve, 100) - 1,
            _ceilPct(reserve, 100),
            _ceilPct(reserve, 300) - 1,
            _ceilPct(reserve, 300),
            _ceilPct(reserve, 500) - 1,
            _ceilPct(reserve, 500),
            _ceilPct(reserve, 1500)
        ];
        uint24[7] memory rates = [uint24(0), 5_000, 5_000, 10_000, 10_000, 20_000, 20_000];
        for (uint256 i; i < sizes.length; ++i) {
            (uint256 gross, uint256 fee) = _sellExactInBoth(sizes[i]);
            eq(uint256(hook.feeRate(sizes[i], reserve)), uint256(rates[i]), "bracket");
            eq(fee, gross * rates[i] / PPM, "fee = gross ETH out * rate");
            eq(hook.reserveSnapshot(), reserve, "snapshot is fixed for the block");
        }
        _assertNoRawCustody();
        _assertReserveReconciles();
    }

    function test_exactOutputSellsPayExactlyTheBracketFeeInBurnedTokens() public {
        uint256 reserve = hook.reserveSnapshot();
