// Launch block: the lagged reserve is empty, so every sell in that block pays the 2% cap (the
// documented conservative branch). One block later ordinary brackets apply.
// ---------------------------------------------------------------------------------------------
contract IMDOLaunchBlockTest is IMDOFixture {
    function setUp() public {
        _launch(V4.TICK_LOWER, V4.TICK_UPPER, true, false);
    }

    function test_launchBlockSellsPayTheCapThenTheLagExpires() public {
        eq(hook.reserveSnapshot(), 0, "no mature reserve yet");
